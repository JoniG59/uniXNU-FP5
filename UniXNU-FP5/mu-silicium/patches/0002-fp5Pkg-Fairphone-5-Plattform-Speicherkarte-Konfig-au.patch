+  gSiliciumPkgTokenSpaceGuid.PcdSmbiosSystemRetailModel|"FP5"
+  gSiliciumPkgTokenSpaceGuid.PcdSmbiosSystemRetailSku|"Fairphone_5_FP5"
+  gSiliciumPkgTokenSpaceGuid.PcdSmbiosSystemBoardModel|"Fairphone 5"
+
+  #
+  # Simple Frame Buffer
+  # NOTE: 1224x2700 is the public FP5 panel resolution, not verified against
+  # the ABL framebuffer on hardware.
+  #
+  gSiliciumPkgTokenSpaceGuid.PcdFrameBufferWidth|1224
+  gSiliciumPkgTokenSpaceGuid.PcdFrameBufferHeight|2700
+  gSiliciumPkgTokenSpaceGuid.PcdFrameBufferColorDepth|32
+
+  #
+  # Platform PEI
+  #
+  gQcomPkgTokenSpaceGuid.PcdPlatformType|"LA"
+
+  #
+  # Storage
+  #

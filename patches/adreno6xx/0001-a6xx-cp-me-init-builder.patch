+IOReturn NativeAdrenoCpInit::buildA6xxMeInit(uint64_t pwrup_reglist_iova,
+    uint32_t *words,size_t capacity,size_t *written)
+{
+    if(!written)return kIOReturnBadArgument;
+    *written=0;
+    if(!words || capacity<CpA6xxInitWords || !pwrup_reglist_iova ||
+        (pwrup_reglist_iova&3) || pwrup_reglist_iova>=UINT64_C(1)<<48)
+        return kIOReturnBadArgument;
+    /* From KGSL's a6xx_cp_init_cmds(), A6XX_CP_INIT_DWORDS=11. The mask
+     * chooses exactly the payload fields below; header-dump and workaround
+     * fields are present as zeroes. Unlike gen7_cp_init_cmds(), this path
+     * does not send CP_THREAD_CONTROL or the GEN7 bit-31 dynamic-list flag. */
+    uint32_t packet[CpA6xxInitWords]={0};
+    if(AdrenoPM4Type7(CpMeInitOpcode,CpA6xxMeInitPayloadWords,&packet[0])!=AdrenoPM4Success)
+        return kIOReturnBadArgument;
+    packet[1]=a6xxMeInitMask();
+    packet[2]=0x00000003; /* three hardware contexts */
+    packet[3]=0x20000000; /* error detection */
+    packet[4]=0;           /* header dump address */
+    packet[5]=0;           /* header dump disabled */
+    packet[6]=0;           /* ucode workaround mask */
+    packet[7]=0x00000002; /* operation mode */
+    packet[8]=(uint32_t)pwrup_reglist_iova;
+    packet[9]=(uint32_t)(pwrup_reglist_iova>>32);
+    packet[10]=0;          /* register-init spinlock */
+    memcpy(words,packet,sizeof(packet));
+    *written=CpA6xxInitWords;
+    return kIOReturnSuccess;
+}

 #include <string.h>
 #include "NativeAdrenoPwrupRegs.h"
 enum : size_t { HeaderBytes=16, PairBytes=8, TripletBytes=12 };
+static bool rangeValid(const void *p,size_t bytes)
+{
+    const uintptr_t at=reinterpret_cast<uintptr_t>(p);
+    return p && bytes && bytes-1<=UINTPTR_MAX-at;
+}
+static bool rangesOverlap(const void *a,size_t na,const void *b,size_t nb)
+{
+    const uintptr_t aa=reinterpret_cast<uintptr_t>(a),bb=reinterpret_cast<uintptr_t>(b);
+    return aa<=bb?bb-aa<na:aa-bb<nb;
+}

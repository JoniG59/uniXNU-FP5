 {
     return HeaderBytes+size_t(counts.ifpc+counts.preemption)*PairBytes+
@@ -21,6 +31,48 @@ IOReturn NativeAdrenoPwrupList::buildA740(int (*read)(void *,uint32_t,uint32_t *
     return pack(counts,nullptr,nullptr,NativeAdrenoA740PwrupRegs,values,nullptr,
         out,capacity,written);
 }
+IOReturn NativeAdrenoPwrupList::packA6xx(uint32_t ifpc_count,const uint32_t *ifpc_regs,
+    const uint32_t *ifpc_values,uint32_t preemption_count,const uint32_t *preemption_regs,
+    const uint32_t *preemption_values,uint8_t *out,size_t capacity,size_t *written)
+{
+    if(!written)return kIOReturnBadArgument;
+    *written=0;
+    if(!out || ifpc_count>0xffffu/2 || preemption_count>0xffffu/2 ||
+        ifpc_count>0xffffu/2-preemption_count ||
+        (ifpc_count && (!ifpc_regs || !ifpc_values)) ||
+        (preemption_count && (!preemption_regs || !preemption_values)))
+        return kIOReturnBadArgument;
+    const size_t ifpc_bytes=size_t(ifpc_count)*sizeof(uint32_t);
+    const size_t preemption_bytes=size_t(preemption_count)*sizeof(uint32_t);
+    const size_t pair_count=size_t(ifpc_count)+preemption_count;
+    const size_t needed=HeaderBytes+pair_count*PairBytes;
+    if(capacity<needed)return kIOReturnNoResources;
+    if(!rangeValid(out,needed) ||
+        (ifpc_count && (!rangeValid(ifpc_regs,ifpc_bytes) || !rangeValid(ifpc_values,ifpc_bytes) ||
+            rangesOverlap(out,needed,ifpc_regs,ifpc_bytes) || rangesOverlap(out,needed,ifpc_values,ifpc_bytes))) ||
+        (preemption_count && (!rangeValid(preemption_regs,preemption_bytes) ||
+            !rangeValid(preemption_values,preemption_bytes) ||
+            rangesOverlap(out,needed,preemption_regs,preemption_bytes) ||
+            rangesOverlap(out,needed,preemption_values,preemption_bytes))))
+        return kIOReturnBadArgument;
+
+    /* KGSL struct cpu_gpu_lock: three lock words, then u16 list_length and
+     * u16 list_offset. A6XX counts dwords after the 16-byte header. */
+    const uint32_t header[4]={0,0,0,
+        ((ifpc_count*2u)<<16)|(ifpc_count*2u+preemption_count*2u)};
+    memcpy(out,header,sizeof(header));
+    size_t offset=HeaderBytes;
+    for(uint32_t i=0;i<ifpc_count;++i) {
+        memcpy(out+offset,ifpc_regs+i,sizeof(uint32_t));offset+=sizeof(uint32_t);
+        memcpy(out+offset,ifpc_values+i,sizeof(uint32_t));offset+=sizeof(uint32_t);
+    }
+    for(uint32_t i=0;i<preemption_count;++i) {
+        memcpy(out+offset,preemption_regs+i,sizeof(uint32_t));offset+=sizeof(uint32_t);
+        memcpy(out+offset,preemption_values+i,sizeof(uint32_t));offset+=sizeof(uint32_t);
+    }
+    *written=needed;
+    return kIOReturnSuccess;
+}
 IOReturn NativeAdrenoPwrupList::pack(const NativeAdrenoPwrupCounts &counts,
     const uint32_t *ifpc_regs,const uint32_t *ifpc_values,
     const uint32_t *preemption_regs,const uint32_t *preemption_values,
